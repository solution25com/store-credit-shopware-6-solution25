{% sw_extends '@Storefront/storefront/page/account/_page.html.twig' %}

{% block page_account_main_content %}
    <div class="store-credit-page">
        <h1>{{ 'store-credit.accountTitle'|trans }}</h1>
        <p class="balance-display">{{ 'store-credit.description'|trans }}:
            {{ (storeCredit.balance|default(0))|currency(storeCredit.currency.isoCode|default(context.currency.isoCode)) }}</p>
        {% if storeCreditsHistory|length %}
            <div class="table-responsive">
                <table class="table">
                    <thead><tr>
                        <th scope="col">{{ 'store-credit.date'|trans }}</th>
                        <th scope="col">{{ 'store-credit.amount'|trans }}</th>
                        <th scope="col">{{ 'store-credit.reason'|trans }}</th>
                    </tr></thead>
                    <tbody>
                        {% for credit in storeCreditsHistory %}
                            <tr>
                                <td>{{ credit.createdAt|format_datetime('medium', 'short') }}</td>
                                <td class="{{ credit.actionType == 'add' ? 'amount-add' : 'amount-deduct' }}">
                                    {{ credit.actionType == 'add' ? '+' : '−' }}{{ credit.amount|currency(credit.currency.isoCode|default(storeCredit.currency.isoCode|default(context.currency.isoCode))) }}
                                </td>
                                <td>{{ credit.reason|default('store-credit.noReason'|trans) }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <p>{{ 'store-credit.noHistory'|trans }}</p>
        {% endif %}
        {% if storeCreditHistoryTotalPages > 1 or storeCreditHistoryPage > 1 %}
            <nav aria-label="{{ 'store-credit.pagination'|trans }}">
                <ul class="pagination">
                    {% if storeCreditHistoryPage > 1 %}
                        <li class="page-item"><a class="page-link" href="{{ path('frontend.account.store-credit.page', {page: storeCreditHistoryPage - 1}) }}">{{ 'store-credit.previous'|trans }}</a></li>
                    {% endif %}
                    <li class="page-item active"><span class="page-link" aria-current="page">{{ storeCreditHistoryPage }}</span></li>
                    {% if storeCreditHistoryPage < storeCreditHistoryTotalPages %}
                        <li class="page-item"><a class="page-link" href="{{ path('frontend.account.store-credit.page', {page: storeCreditHistoryPage + 1}) }}">{{ 'store-credit.next'|trans }}</a></li>
                    {% endif %}
                </ul>
            </nav>
        {% endif %}
    </div>
{% endblock %}
