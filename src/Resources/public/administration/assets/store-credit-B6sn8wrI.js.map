<sw-page class="store-credits-index">
        <template #smart-bar-header>
            <sw-page-title>Store Credits</sw-page-title>

            <mt-button
                    size="small"
                    variant="primary"
                    :disabled="isSaving || !acl.can('store_credit.editor')" @click="openAddCustomerModal"
                    class="sw-page__header-add-credit-button"
            >
                Add Customer Credit
            </mt-button>
        </template>

        <template #content>
            <div class="store-credits-index__toolbar">
                <sw-simple-search-field
                    v-model:value="term"
                    size="default"
                    variant="form"
                    :placeholder="$t('store-credits.listing.searchPlaceholder')"
                    @search-term-change="onSearch"
                />
            </div>

            <sw-data-grid
                    :dataSource="storeCredits"
                    :columns="columns"
                    :isLoading="isLoading"
                    :showSelection="false"
                    :showActions="true"
                    :total="total"
                    :limit="limit"
                    :page="page"
                    @page-change="onPageChange"
                    @limit-change="onLimitChange"
            >
                <!-- Columns -->
                <template #column-customerFullName="{ item }">
                    <router-link
                        :to="{ name: 'sw.customer.detail', params: { id: item.customerId } }"
                        class="customer-name-link"
                    >
                        {{ item.customerFullName }}
                    </router-link>
                </template>

                <template #column-balance="{ item }">
                    <span class="store-credit-balance">
                        <mt-icon name="regular-wallet" :size="16" class="balance-icon"></mt-icon>
                        {{ formatCurrency(item.balance, item.currencyIsoCode) }}
                    </span>
                </template>

                <template #column-actions="{ item }">
                    <mt-button
                            size="small"
                            variant="primary"
                            :disabled="isSaving || !acl.can('store_credit.editor')" @click="openAddBalanceModal(item)"
                    >
                        <mt-icon name="regular-plus-circle" :size="16"></mt-icon>
                        Add Balance
                    </mt-button>
                    <mt-button
                            size="small"
                            variant="critical"
                            :disabled="isSaving || !acl.can('store_credit.editor')" @click="openDeductBalanceModal(item)"
                    >
                        <mt-icon name="regular-minus-circle" :size="16"></mt-icon>
                        Deduct Balance
                    </mt-button>
                </template>

                <template #actions="{ item }">
                    <sw-context-menu-item
                            @click="navigateToCustomerHistory(item.storeCreditId, item.customerFullName, item.balance)"
                    >
                        View History
                    </sw-context-menu-item>
                    <sw-context-menu-item
                            :disabled="isSaving || !acl.can('store_credit.deleter')" @click="openDeleteModal(item)"
                            icon="regular-trash"
                            variant="danger"
                    >
                        Delete
                    </sw-context-menu-item>
                </template>

                <!-- Pagination slot -->
                <template #pagination>
                    <sw-pagination
                            :total="total"
                            :limit="limit"
                            :page="page"
                            :total-visible="7"
                            @page-change="onPageChange"
                            @limit-change="onLimitChange"
                    />
                </template>
            </sw-data-grid>

            <!-- Add Balance Modal -->
            <sw-modal
                    v-if="addBalanceModalVisible"
                    title="Add Balance"
                    @modal-close="addBalanceModalVisible = false"
            >
                <template #modal-header>
                    <h3 class="sw-modal__title">
                        <mt-icon name="regular-plus-circle" :size="24"></mt-icon>
                        Add Balance
                    </h3>
                </template>
                <mt-number-field
                        v-model="amount"
                        label="Amount"
                        :min="0.00"
                        :step="0.01"
                        :number-type="'float'"
                        placeholder="0.00"
                        required
                />
                <mt-text-field
                        v-model="reason"
                        label="Reason"
                        placeholder="Enter reason for adding balance"
                />
                <template #modal-footer>
                    <mt-button @click="addBalanceModalVisible = false" size="small">
                        Cancel
                    </mt-button>
                    <mt-button :disabled="isSaving || !acl.can('store_credit.editor')" @click="addBalance" size="small" variant="primary">
                        <mt-icon name="regular-check" :size="16"></mt-icon>
                        Add Balance
                    </mt-button>
                </template>
            </sw-modal>

            <!-- Deduct Balance Modal -->
            <sw-modal
                    v-if="deductBalanceModalVisible"
                    title="Deduct Balance"
                    @modal-close="deductBalanceModalVisible = false"
            >
                <template #modal-header>
                    <h3 class="sw-modal__title">
                        <mt-icon name="regular-minus-circle" :size="24"></mt-icon>
                        Deduct Balance
                    </h3>
                </template>
                <mt-number-field
                        v-model="amount"
                        label="Amount"
                        :min="0.00"
                        :step="0.01"
                        :number-type="'float'"
                        placeholder="0.00"
                        required
                />
                <mt-text-field
                        v-model="reason"
                        label="Reason"
                        placeholder="Enter reason for deducting balance"
                />
                <template #modal-footer>
                    <mt-button @click="deductBalanceModalVisible = false" size="small">
                        Cancel
                    </mt-button>
                    <mt-button :disabled="isSaving || !acl.can('store_credit.editor')" @click="deductBalance" size="small" variant="critical">
                        <mt-icon name="regular-check" :size="16"></mt-icon>
                        Deduct Balance
                    </mt-button>
                </template>
            </sw-modal>

            <!-- Delete Confirmation Modal -->
            <sw-modal
                    v-if="confirmDeleteModalVisible"
                    title="Confirm Delete"
                    variant="small"
                    @modal-close="confirmDeleteModalVisible = false"
            >
                <template #modal-header>
                    <h3 class="sw-modal__title">
                        <mt-icon name="regular-exclamation-triangle" :size="24" color="#de294c"></mt-icon>
                        Confirm Delete
                    </h3>
                </template>
                <p class="sw-modal__body-text">
                    Are you sure you want to delete this customer's store credit and all the history?
                    This action cannot be undone.
                </p>
                <template #modal-footer>
                    <mt-button
                            @click="confirmDeleteModalVisible = false"
                            size="small"
                    >
                        Cancel
                    </mt-button>
                    <mt-button
                            :disabled="isSaving || !acl.can('store_credit.deleter')" @click="deleteStoreCredit"
                            size="small"
                            variant="critical"
                    >
                        <mt-icon name="regular-trash" :size="16"></mt-icon>
                        Delete
                    </mt-button>
                </template>
            </sw-modal>

            <!-- Add Customer Credit Modal -->
            <sw-modal
                    v-if="addCustomerModalVisible"
                    title="Add Customer Store Credit"
                    @modal-close="addCustomerModalVisible = false"
                    size="large"
            >
                <sw-customer-grid v-model:value="selectedNewCustomer"/>
                <mt-card title="Amount">
                    <mt-number-field
                            v-model="newCustomerAmount"
                            :min="0.00"
                            :step="0.01"
                            :number-type="'float'"
                            placeholder="Enter amount"
                    />
                </mt-card>
                <template #modal-footer>
                    <mt-button :disabled="isSaving || !acl.can('store_credit.editor')" @click="addCustomerCredit" size="small" variant="primary">
                        Submit
                    </mt-button>
                    <mt-button @click="addCustomerModalVisible = false" size="small" variant="critical">
                        Cancel
                    </mt-button>
                </template>
            </sw-modal>
        </template>
    </sw-page>
