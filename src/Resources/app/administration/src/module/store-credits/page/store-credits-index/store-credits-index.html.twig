<template>
    <sw-page class="store-credits-index">
        <template #smart-bar-header>
            <sw-page-title>{{ $tc('store-credits.module.title') }}</sw-page-title>

            <sw-button
                    size="small"
                    variant="primary"
                    @click="openAddCustomerModal"
                    class="sw-page__header-add-credit-button"
            >
                {{ $tc('store-credits.listing.addCustomerCredit') }}
            </sw-button>
        </template>

        <template #content>
            <div class="store-credits-index__toolbar">
                <sw-simple-search-field
                    v-model:value="term"
                    size="default"
                    variant="form"
                    :placeholder="$tc('store-credits.listing.searchPlaceholder')"
                    @search-term-change="onSearch"
                />
            </div>

            <sw-data-grid
                    :dataSource="storeCredits"
                    :columns="columns"
                    :isLoading="isLoading"
                    :showSelection="false"
                    :showActions="true"
                    :total="total"
                    :limit="limit"
                    :page="page"
                    @page-change="onPageChange"
                    @limit-change="onLimitChange"
            >
                <!-- Columns -->
                <template #column-customerFullName="{ item }">
                    <router-link 
                        :to="{ name: 'sw.customer.detail', params: { id: item.customerId } }"
                        class="customer-name-link"
                    >
                        {{ item.customerFullName }}
                    </router-link>
                </template>

                <template #column-balance="{ item }">
                    <span class="store-credit-balance">
                        <sw-icon name="regular-wallet" size="16px" class="balance-icon"></sw-icon>
                        {{ formatCurrency(item.balance, item.currencyIsoCode) }}
                    </span>
                </template>

                <template #column-actions="{ item }">
                    <sw-button
                            size="small"
                            variant="primary"
                            class="store-credits-index__action-button store-credits-index__action-button--add"
                            @click="openAddBalanceModal(item)"
                    >
                        <sw-icon name="regular-plus-circle" small />
                        {{ $tc('store-credits.listing.addBalance') }}
                    </sw-button>
                    <sw-button
                            size="small"
                            variant="danger"
                            class="store-credits-index__action-button store-credits-index__action-button--deduct"
                            @click="openDeductBalanceModal(item)"
                    >
                        <sw-icon name="regular-minus-circle" small />
                        {{ $tc('store-credits.listing.deductBalance') }}
                    </sw-button>
                </template>

                <template #actions="{ item }">
                    <sw-context-menu-item
                            @click="navigateToCustomerHistory(item.storeCreditId, item.customerFullName, item.balance)"
                    >
                        {{ $tc('store-credits.listing.viewHistory') }}
                    </sw-context-menu-item>
                    <sw-context-menu-item
                            @click="openDeleteModal(item)"
                            icon="regular-trash"
                            variant="danger"
                    >
                        {{ $tc('store-credits.common.delete') }}
                    </sw-context-menu-item>
                </template>

                <!-- Pagination slot -->
                <template #pagination>
                    <sw-pagination
                            :total="total"
                            :limit="limit"
                            :page="page"
                            :steps="[10, 25, 50]"
                            :total-visible="7"
                            @page-change="onPageChange"
                            @limit-change="onLimitChange"
                    />
                </template>
            </sw-data-grid>

            <!-- Add Balance Modal -->
            <sw-modal
                    v-if="addBalanceModalVisible"
                    :title="$tc('store-credits.listing.addBalanceModalTitle')"
                    :isLoading="isSubmitting"
                    @modal-close="addBalanceModalVisible = false"
            >
                <template #modal-header>
                    <h3 class="sw-modal__title">
                        <sw-icon name="regular-plus-circle" size="24px"></sw-icon>
                        {{ $tc('store-credits.listing.addBalanceModalTitle') }}
                    </h3>
                </template>
                <sw-number-field
                        v-model:value="amount"
                        :label="$tc('store-credits.listing.amountLabel')"
                        :min="0.00"
                        :step="0.01"
                        :number-type="'float'"
                        :placeholder="$tc('store-credits.listing.amountPlaceholder')"
                        :disabled="isSubmitting"
                        required
                />
                <sw-text-field 
                        v-model:value="reason" 
                        :label="$tc('store-credits.listing.reasonLabel')" 
                        :placeholder="$tc('store-credits.listing.reasonAddPlaceholder')"
                        :disabled="isSubmitting"
                />
                <template #modal-footer>
                    <sw-button @click="addBalanceModalVisible = false" size="small" :disabled="isSubmitting">
                        {{ $tc('store-credits.common.cancel') }}
                    </sw-button>
                    <sw-button @click="addBalance" size="small" variant="primary" :disabled="isSubmitting" :isLoading="isSubmitting">
                        <sw-icon name="regular-plus-circle" small />
                        {{ $tc('store-credits.listing.addBalance') }}
                    </sw-button>
                </template>
            </sw-modal>

            <!-- Deduct Balance Modal -->
            <sw-modal
                    v-if="deductBalanceModalVisible"
                    :title="$tc('store-credits.listing.deductBalanceModalTitle')"
                    :isLoading="isSubmitting"
                    @modal-close="deductBalanceModalVisible = false"
            >
                <template #modal-header>
                    <h3 class="sw-modal__title">
                        <sw-icon name="regular-minus-circle" size="24px"></sw-icon>
                        {{ $tc('store-credits.listing.deductBalanceModalTitle') }}
                    </h3>
                </template>
                <sw-number-field
                        v-model:value="amount"
                        :label="$tc('store-credits.listing.amountLabel')"
                        :min="0.00"
                        :step="0.01"
                        :number-type="'float'"
                        :placeholder="$tc('store-credits.listing.amountPlaceholder')"
                        :disabled="isSubmitting"
                        required
                />
                <sw-text-field 
                        v-model:value="reason" 
                        :label="$tc('store-credits.listing.reasonLabel')" 
                        :placeholder="$tc('store-credits.listing.reasonDeductPlaceholder')"
                        :disabled="isSubmitting"
                />
                <sw-alert
                        v-if="reservedConfirmRequired"
                        variant="warning"
                >
                    {{ reservedNotice }}
                </sw-alert>
                <sw-checkbox-field
                        v-if="reservedConfirmRequired"
                        v-model:value="allowReserved"
                        :label="$tc('store-credits.customer.reservedConfirmCheckbox')"
                        :disabled="isSubmitting"
                />
                <template #modal-footer>
                    <sw-button @click="deductBalanceModalVisible = false" size="small" :disabled="isSubmitting">
                        {{ $tc('store-credits.common.cancel') }}
                    </sw-button>
                    <sw-button @click="deductBalance" size="small" variant="danger" :disabled="isSubmitting || (reservedConfirmRequired && !allowReserved)" :isLoading="isSubmitting">
                        <sw-icon name="regular-minus-circle" small />
                        {{ $tc('store-credits.listing.deductBalance') }}
                    </sw-button>
                </template>
            </sw-modal>

            <!-- Delete Confirmation Modal -->
            <sw-modal
                    v-if="confirmDeleteModalVisible"
                    :title="$tc('store-credits.listing.confirmDelete')"
                    variant="small"
                    @modal-close="confirmDeleteModalVisible = false"
            >
                <template #modal-header>
                    <h3 class="sw-modal__title">
                        <sw-icon name="regular-exclamation-triangle" size="24px" color="#de294c"></sw-icon>
                        {{ $tc('store-credits.listing.confirmDelete') }}
                    </h3>
                </template>
                <p class="sw-modal__body-text">
                    {{ $tc('store-credits.listing.confirmDeleteText') }}
                </p>
                <template #modal-footer>
                    <sw-button
                            @click="confirmDeleteModalVisible = false"
                            size="small"
                    >
                        {{ $tc('store-credits.common.cancel') }}
                    </sw-button>
                    <sw-button
                            @click="deleteStoreCredit"
                            size="small"
                            variant="danger"
                    >
                        <sw-icon name="regular-trash" small />
                        {{ $tc('store-credits.common.delete') }}
                    </sw-button>
                </template>
            </sw-modal>

            <!-- Add Customer Credit Modal -->
            <sw-modal
                    v-if="addCustomerModalVisible"
                    :title="$tc('store-credits.listing.addCustomerModalTitle')"
                    @modal-close="addCustomerModalVisible = false"
                    size="large"
            >
                <sw-customer-grid v-model:value="selectedNewCustomer"/>
                <sw-card :title="$tc('store-credits.listing.amountCardTitle')">
                    <sw-number-field
                            v-model:value="newCustomerAmount"
                            :min="0.00"
                            :step="0.00"
                            :number-type="'float'"
                            :placeholder="$tc('store-credits.listing.amountPlaceholder')"
                            :disabled="isSubmitting"
                    />
                </sw-card>
                <template #modal-footer>
                    <sw-button @click="addCustomerCredit" size="small" variant="primary" :disabled="isSubmitting" :isLoading="isSubmitting">
                        {{ $tc('store-credits.common.submit') }}
                    </sw-button>
                    <sw-button @click="addCustomerModalVisible = false" size="small" variant="danger" :disabled="isSubmitting">
                        {{ $tc('store-credits.common.cancel') }}
                    </sw-button>
                </template>
            </sw-modal>
        </template>
    </sw-page>
</template>