{% block sw_customer_detail_store_credits %}
<div class="sw-customer-detail-store-credits">
    {% block sw_customer_detail_store_credits_card %}
    <mt-card
        class="sw-customer-detail-store-credits__card"
        :is-loading="isLoading"
        :title="$t('store-credits.customer.tabTitle')"
    >
        {% block sw_customer_detail_store_credits_balance %}
        <div class="sw-customer-detail-store-credits__balance-section">
            <div class="sw-customer-detail-store-credits__balance-card">
                <mt-icon
                    name="regular-wallet"
                    :size="48"
                    class="sw-customer-detail-store-credits__balance-icon"
                />
                <div class="sw-customer-detail-store-credits__balance-info">
                    <div class="sw-customer-detail-store-credits__balance-label">
                        {{ $t('store-credits.customer.currentBalance') }}
                    </div>
                    <div class="sw-customer-detail-store-credits__balance-amount">
                        {{ formatCurrency(balance) }}
                    </div>
                </div>
            </div>
        </div>
        {% endblock %}

        {% block sw_customer_detail_store_credits_actions %}
        <div class="sw-customer-detail-store-credits__actions">
            <mt-button
                variant="primary"
                :disabled="isSaving || !acl.can('store_credit.editor') || isLoading"
                @click="openAddModal"
            >
                <mt-icon name="regular-plus-circle" :size="16" />
                {{ $t('store-credits.customer.addCredit') }}
            </mt-button>

            <mt-button
                variant="critical"
                :disabled="isSaving || !acl.can('store_credit.editor') || isLoading || balance <= 0"
                @click="openDeductModal"
            >
                <mt-icon name="regular-minus-circle" :size="16" />
                {{ $t('store-credits.customer.deductCredit') }}
            </mt-button>
        </div>
        {% endblock %}
    </mt-card>
    {% endblock %}

    {% block sw_customer_detail_store_credits_add_modal %}
    <sw-modal
        v-if="showAddModal"
        :title="$t('store-credits.customer.addCredit')"
        @modal-close="closeAddModal"
    >
        {% block sw_customer_detail_store_credits_add_modal_content %}
        <sw-container
            columns="1fr"
            gap="0 30px"
        >
            <mt-number-field
                v-model="addAmount"
                :label="$t('store-credits.customer.amount')"
                :placeholder="$t('store-credits.customer.amountPlaceholder')"
                :min="0"
                :step="0.01"
                number-type="float"
            />

            <mt-textarea
                v-model="addReason"
                :label="$t('store-credits.customer.reason')"
                :placeholder="$t('store-credits.customer.reasonPlaceholder')"
            />
        </sw-container>
        {% endblock %}

        {% block sw_customer_detail_store_credits_add_modal_footer %}
        <template #modal-footer>
            <mt-button
                @click="closeAddModal"
            >
                {{ $t('global.default.cancel') }}
            </mt-button>

            <mt-button
                variant="primary"
                :disabled="isSaving || !acl.can('store_credit.editor') || isLoading || !addAmount || addAmount <= 0"
                @click="addCredit"
            >
                {{ $t('store-credits.customer.addCredit') }}
            </mt-button>
        </template>
        {% endblock %}
    </sw-modal>
    {% endblock %}

    {% block sw_customer_detail_store_credits_deduct_modal %}
    <sw-modal
        v-if="showDeductModal"
        :title="$t('store-credits.customer.deductCredit')"
        @modal-close="closeDeductModal"
    >
        {% block sw_customer_detail_store_credits_deduct_modal_content %}
        <sw-container
            columns="1fr"
            gap="0 30px"
        >
            <mt-number-field
                v-model="deductAmount"
                :label="$t('store-credits.customer.amount')"
                :placeholder="$t('store-credits.customer.amountPlaceholder')"
                :min="0"
                :max="balance"
                :step="0.01"
                number-type="float"
            />

            <mt-textarea
                v-model="deductReason"
                :label="$t('store-credits.customer.reason')"
                :placeholder="$t('store-credits.customer.reasonPlaceholder')"
            />
        </sw-container>
        {% endblock %}

        {% block sw_customer_detail_store_credits_deduct_modal_footer %}
        <template #modal-footer>
            <mt-button
                @click="closeDeductModal"
            >
                {{ $t('global.default.cancel') }}
            </mt-button>

            <mt-button
                variant="critical"
                :disabled="isSaving || !acl.can('store_credit.editor') || isLoading || !deductAmount || deductAmount <= 0 || deductAmount > balance"
                @click="deductCredit"
            >
                {{ $t('store-credits.customer.deductCredit') }}
            </mt-button>
        </template>
        {% endblock %}
    </sw-modal>
    {% endblock %}
</div>
{% endblock %}

