{
    "name": "solution25/store-credit",
    "description": "Store Credit for Shopware 6",
    "type": "shopware-platform-plugin",
    "version": "1.2.0",
    "license": "MIT",
    "authors": [
        {
            "name": "solution 25",
            "role": "Manufacturer"
        }
    ],
    "require": {
        "php": "^8.2",
        "shopware/core": "~6.7.0",
        "shopware/storefront": "~6.7.0"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^4.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "extra": {
        "shopware-plugin-class": "Solu1StoreCredit\\StoreCredit",
        "label": {
            "de-DE": "Store Credit",
            "en-GB": "Store Credit"
        },
        "description": {
            "de-DE": "Verwalten Sie Guthaben f\u00fcr Retouren einfach. Admins weisen Kundenkonten Guthaben zu, das flexibel f\u00fcr zuk\u00fcnftige Eink\u00e4ufe genutzt werden kann, bis der Betrag aufgebraucht ist.",
            "en-GB": "Manage store credits for returns easily. Admins allocate credit to customer accounts, usable for future purchases until the balance is fully utilized. Alternative to refunds."
        },
        "manufacturerLink": {
            "de-DE": "https://solution25.com/",
            "en-GB": "https://solution25.com/en/home_en/"
        },
        "supportLink": {
            "de-DE": "https://solution25.com/",
            "en-GB": "https://solution25.com/en/home_en/"
        }
    },
    "autoload": {
        "psr-4": {
            "Solu1StoreCredit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Solu1StoreCredit\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        }
    }
}
